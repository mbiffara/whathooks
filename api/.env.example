# Database
DATABASE_URL="postgresql://USER@localhost:5432/whathooks?schema=public"

# Redis
REDIS_URL="redis://localhost:6379"

# Server
PORT=3001
NODE_ENV=development

# Auth — must match the frontend's AUTH_SECRET. JWTs the API issues are signed with this.
JWT_SECRET="change-me-in-prod"
JWT_EXPIRES_IN="7d"

# CORS — frontend origin allowed to call the API
WEB_ORIGIN="http://localhost:3000"

# API key token prefix (cosmetic)
API_KEY_PREFIX="wh_live"

# Media storage. Set MEDIA_BUCKET to use S3; otherwise media is stored on local
# disk under MEDIA_DIR and served via signed proxy links.
# MEDIA_BUCKET=""
MEDIA_DIR=".media"
# Public base URL of this API (used to build local media proxy links)
PUBLIC_API_URL="http://localhost:3001"

# CloudWatch metrics (set the namespace to enable; disabled when empty / local)
# METRICS_NAMESPACE="whathooks"

# AES-256-GCM key (32 raw bytes, base64) used to encrypt each agent's provider
# API key at rest. Generate with: openssl rand -base64 32
# Agents can't be created or run until this is set. Prod uses a Secrets Manager
# secret; this is the dev value.
AGENT_ENCRYPTION_KEY=""

# Team invitations. Email is optional — without RESEND_API_KEY invites still
# work via copyable links (built from WEB_ORIGIN above).
# RESEND_API_KEY=""
MAIL_FROM="whathooks <onboarding@resend.dev>"
INVITE_TTL_DAYS=7

# Stripe billing. Secret key + webhook signing secret from the Stripe dashboard,
# plus the recurring Price id for each plan. Without STRIPE_SECRET_KEY the
# billing endpoints return "Billing is not configured" (fine for local dev).
# STRIPE_SECRET_KEY="sk_test_..."
# STRIPE_WEBHOOK_SECRET="whsec_..."
# STRIPE_PRICE_STARTER="price_..."   # $9.99/mo
# STRIPE_PRICE_PRO="price_..."       # $29.99/mo
# STRIPE_PRICE_BUSINESS="price_..."  # $99/mo
# STRIPE_PORTAL_CONFIG="bpc_..."     # optional; needed when the portal config was created via API (not Dashboard default)

# X (Twitter) Conversion API — server-side ad attribution. Without these the
# service no-ops. Event ids come from X Events Manager for pixel re0yu.
# X_PIXEL_ID="re0yu"
# X_PIXEL_TOKEN=""
# X_EVENT_SIGNUP="tw-re0yu-..."
# X_EVENT_SUBSCRIBE="tw-re0yu-..."
