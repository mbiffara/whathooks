# Database
DATABASE_URL="postgresql://USER@localhost:5432/whathooks?schema=public"

# Redis
REDIS_URL="redis://localhost:6379"

# Server
PORT=3001
NODE_ENV=development

# Auth — must match the frontend's AUTH_SECRET. JWTs the API issues are signed with this.
JWT_SECRET="change-me-in-prod"
JWT_EXPIRES_IN="7d"

# CORS — frontend origin allowed to call the API
WEB_ORIGIN="http://localhost:3000"

# API key token prefix (cosmetic)
API_KEY_PREFIX="wh_live"

# Media storage. Set MEDIA_BUCKET to use S3; otherwise media is stored on local
# disk under MEDIA_DIR and served via signed proxy links.
# MEDIA_BUCKET=""
MEDIA_DIR=".media"
# Public base URL of this API (used to build local media proxy links)
PUBLIC_API_URL="http://localhost:3001"

# CloudWatch metrics (set the namespace to enable; disabled when empty / local)
# METRICS_NAMESPACE="whathooks"

# AES-256-GCM key (32 raw bytes, base64) used to encrypt each agent's provider
# API key at rest. Generate with: openssl rand -base64 32
# Agents can't be created or run until this is set. Prod uses a Secrets Manager
# secret; this is the dev value.
AGENT_ENCRYPTION_KEY=""
