# Copy to infra/.env (gitignored) and fill in. These are resource identifiers, not
# secrets — the actual DB password lives in Secrets Manager, referenced by ARN.
# `npm run deploy` (or `npx cdk deploy`) will pick these up automatically.

# --- required ---
WH_VPC_ID=vpc-0abc123...
WH_DATABASE_URL_SECRET_ARN=arn:aws:secretsmanager:us-east-1:111122223333:secret:whathooks/database-url-XXXX
WH_REDIS_URL=redis://your-elasticache-host:6379
WH_DB_SG_ID=sg-0rds...
WH_REDIS_SG_ID=sg-0redis...
WH_WEB_ORIGIN=https://your-app.vercel.app

# --- optional ---
# WH_CERT_ARN=arn:aws:acm:us-east-1:111122223333:certificate/XXXX
# WH_DOMAIN_NAME=api.yourdomain.com
# WH_DB_PORT=5432
# WH_TASK_SUBNET_TYPE=public   # or 'private' (requires NAT egress)
