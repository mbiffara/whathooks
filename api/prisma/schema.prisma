// whathooks data model
// Multi-tenant: an Organization owns WhatsApp sessions, webhooks, API keys and message logs.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Tenancy & auth
// ---------------------------------------------------------------------------

enum UserRole {
  ADMIN // platform administrator (whathooks staff)
  CLIENT // organization user
}

// Role of a user within one organization. Membership is the source of truth
// for org access; User.organizationId only remembers the active selection.
enum OrgRole {
  OWNER // full control: team, ownership transfer, delete org
  ADMIN // manage sessions, agents, webhooks, API keys, invites
  MEMBER // operate: view resources, read/send messages
  OPERATOR // inbox only: sees just the conversations assigned to them
}

// Subscription tier. Limits (messages/month, history window, WA numbers) are
// defined in code (src/billing/plans.ts), not the DB.
enum Plan {
  STARTER // $9.99  — 5k msgs/mo, 30-day history, 1 number
  PRO // $29.99 — 10k msgs/mo, 90-day history, 3 numbers
  BUSINESS // $99   — 100k msgs/mo, full history, 10 numbers
  SPONSORED // comped — unlimited, no subscription required; assigned manually
}

model Organization {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Billing (Stripe). plan is the entitlement tier; subscriptionStatus mirrors
  // the Stripe subscription state (active | trialing | past_due | canceled | …).
  plan                 Plan      @default(STARTER)
  // Admin override for the monthly message cap (null = plan/trial default).
  messageLimitOverride Int?
  // Purchased AI tokens still unspent. Unlike the plan's monthly allowance
  // this carries over: it is only ever decremented by use, and topped up by
  // a token-pack purchase. Included tokens are always spent first.
  paidAiTokens         Int       @default(0)
  // X ads click id captured at signup (twclid) — used to attribute the later
  // paid-subscription conversion via X's Conversion API. Never shown in UI.
  adClickId            String?
  // Instagram accounts the org is paying for, as a subscription add-on. Written
  // ONLY by syncSubscription from the Stripe item quantity, never by the
  // endpoint that requests a change: that way a declined card cannot grant a
  // seat. Compare against the count of INSTAGRAM sessions to gate connecting.
  instagramSeats       Int       @default(0)
  // Zernio profile for this org — their tenant boundary, one per organization.
  // Created lazily on the first Instagram connection.
  zernioProfileId      String?
  stripeCustomerId     String?   @unique
  stripeSubscriptionId String?   @unique
  stripePriceId        String?
  subscriptionStatus   String?
  currentPeriodEnd     DateTime?

  users         User[]
  memberships   Membership[]
  invitations   Invitation[]
  aiTokenUsage  AiTokenUsage[]
  aiTokenDaily  AiTokenDailyUsage[]
  aiTokenPurchases AiTokenPurchase[]
  sessions      WaSession[]
  webhooks      Webhook[]
  apiKeys       ApiKey[]
  agents        Agent[]
  conversations Conversation[]
  messages      Message[]
  tags         Tag[]
  quickReplies QuickReply[]
  contacts     Contact[]
  humanAgents HumanAgent[]
  flows Flow[]
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String?
  // UI + email language ("en" | "es"). Set from the visitor's locale at
  // signup; editable in dashboard settings.
  locale       String   @default("en")
  welcomeEmailSentAt DateTime?
  role         UserRole @default(CLIENT)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Active (last selected) organization — Membership is the source of truth.
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  memberships     Membership[]
  sentInvitations Invitation[] @relation("SentInvitations")
  passwordResets  PasswordResetToken[]

  @@index([organizationId])
  sentMessages          Message[]      @relation("SentMessages")
  assignedConversations Conversation[] @relation("AssignedConversations")
  humanAgents           HumanAgent[]
}

// Single-use, short-lived tokens for the forgot-password flow. Only the
// SHA-256 hash is stored (same hashToken as API keys and invitations).
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model Membership {
  id             String       @id @default(cuid())
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  role           OrgRole      @default(MEMBER)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([userId, organizationId])
  @@index([organizationId])
  // Session-level access for MEMBER/OPERATOR: empty = all sessions
  // (default); ignored for OWNER/ADMIN.
  sessionIds String[] @default([])
}

// Pending/accepted invites to join an organization. The raw token is shown
// once (invite link); only its sha-256 lands here. Status is derived:
// pending = !acceptedAt && !revokedAt && expiresAt > now().
model Invitation {
  id               String       @id @default(cuid())
  organizationId   String
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  email            String
  role             OrgRole      @default(MEMBER)
  tokenHash        String       @unique
  invitedById      String?
  invitedBy        User?        @relation("SentInvitations", fields: [invitedById], references: [id], onDelete: SetNull)
  acceptedByUserId String?
  expiresAt        DateTime
  acceptedAt       DateTime?
  revokedAt        DateTime?
  createdAt        DateTime     @default(now())

  @@index([organizationId])
  @@index([email])
}

// ---------------------------------------------------------------------------
// Connected accounts. Still called WaSession because every sessionId FK in the
// schema already means "the account this row belongs to"; renaming the model
// would churn ~50 call sites without changing a single relationship. The
// `channel` column is what actually distinguishes a Baileys socket from a
// webhook-delivered channel like Instagram.
// ---------------------------------------------------------------------------

enum Channel {
  WHATSAPP // Baileys socket, QR-paired
  INSTAGRAM // Zernio API, OAuth-connected, webhook-delivered
}

enum WaSessionStatus {
  PENDING // created, worker not started yet
  QR // waiting for the user to scan a QR
  CONNECTING // pairing / reconnecting
  CONNECTED // online and ready
  DISCONNECTED // dropped, will retry
  LOGGED_OUT // unrecoverable, requires re-scan
}

model WaSession {
  id             String          @id @default(cuid())
  organizationId String
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  label          String // human label, e.g. "Support line"
  channel        Channel         @default(WHATSAPP)
  phoneNumber    String? // msisdn once connected (WHATSAPP only)
  status         WaSessionStatus @default(PENDING)
  // Auto-save every inbound DM sender into the org's contact book.
  saveContacts   Boolean         @default(false)
  contacts       Contact[]
  qr             String? // latest QR string while status = QR (transient)
  lastConnectedAt DateTime?
  // Set when a "session down / unlinked" alert email went out for the current
  // outage; cleared (with a recovery email) when the session reconnects.
  alertedDisconnectAt DateTime?
  // Public QR-sharing link: lets someone without a whathooks account open
  // /connect/<token> and scan the QR. Valid 24h from creation; regenerating
  // replaces the token, clearing revokes it.
  shareToken          String?   @unique
  shareTokenCreatedAt DateTime?

  // Non-WhatsApp channels. The provider owns the account identity, so these
  // stand in for phoneNumber/creds/signalKeys, which stay null for them.
  // externalAccountId is unique because inbound webhooks arrive on one shared
  // endpoint for the whole platform and it is the only thing that routes an
  // event to an organization.
  externalAccountId String? @unique // Zernio accountId
  externalProfileId String? // Zernio profile (one per organization)
  externalHandle    String? // the @handle, shown where a phone number would be

  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  agentId String?
  agent   Agent?  @relation(fields: [agentId], references: [id], onDelete: SetNull)


  creds         WaCredential?
  signalKeys    WaSignalKey[]
  conversations Conversation[]
  messages      Message[]
  webhooks      Webhook[]
  mirrorLink    MirrorLink?
  mirrorThreads MirrorThread[]
  flow          Flow?

  @@index([organizationId])
  @@index([agentId])
}

enum AgentProvider {
  ANTHROPIC
  OPENAI
}

// An AI auto-responder: a personality ("soul") + behavior ("instructions"),
// backed by an LLM (provider + model + the org's own API key), assignable to
// one or more WhatsApp sessions.
model Agent {
  id              String        @id @default(cuid())
  organizationId  String
  organization    Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name            String
  soul            String // personality / character
  instructions    String // behavioral instructions
  provider        AgentProvider @default(ANTHROPIC)
  model           String        @default("claude-opus-4-8")
  // Run on the platform's OpenAI account against the plan's monthly token
  // allowance instead of the org's own key. Mutually exclusive with a stored
  // key: included agents keep apiKeyCiphertext null.
  useIncludedAi   Boolean       @default(false)
  apiKeyCiphertext String? // AES-256-GCM encrypted provider API key (BYOK only)
  apiKeyHint      String? // last chars, for display (e.g. "sk-…aB12")
  maxTokens       Int           @default(1024)
  allowAutoStop   Boolean       @default(false) // give the agent a tool to pause itself (handoff to human)
  notifyOnHandoff Boolean       @default(false) // email the team when the agent hands off
  // MCP servers the agent may call tools on (Anthropic provider only, Pro+
  // plans). Shape: [{ name, url, authTokenCiphertext?, authTokenHint? }] —
  // see agents/mcp-servers.ts. Tokens encrypted like apiKeyCiphertext.
  mcpServers      Json?
  replyDelayMinSeconds Int      @default(0) // hold the reply a random time in [min,max] (0 = send immediately)
  replyDelayMaxSeconds Int      @default(0)
  // Active-hours schedule: when set, the agent only auto-replies inside the
  // window. Days are 0-6 (Sunday=0) in scheduleTimezone; minutes are from
  // midnight. end <= start means the window crosses midnight.
  scheduleEnabled     Boolean  @default(false)
  scheduleDays        Int[]    @default([])
  scheduleStartMinute Int      @default(0)
  scheduleEndMinute   Int      @default(0)
  scheduleTimezone    String   @default("UTC")
  enabled         Boolean       @default(true)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  sessions WaSession[]
  messages Message[]
  knowledgeDocs AgentKnowledgeDoc[]
  aiTokenDaily  AiTokenDailyUsage[]

  @@index([organizationId])
}

// Reference documents injected into the agent's system prompt (context
// injection — no RAG). Text is extracted once at upload; caps are enforced
// in AgentsService (docs per agent, total characters).
model AgentKnowledgeDoc {
  id             String   @id @default(cuid())
  organizationId String
  agentId        String
  agent          Agent    @relation(fields: [agentId], references: [id], onDelete: Cascade)
  fileName       String
  mimeType       String
  sizeBytes      Int
  charCount      Int
  text           String
  createdAt      DateTime @default(now())

  @@index([agentId])
}

// Baileys auth state, persisted to Postgres so sockets survive restarts.
model WaCredential {
  sessionId String    @id
  session   WaSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  creds     Json
  updatedAt DateTime  @updatedAt
}

model WaSignalKey {
  id        String    @id @default(cuid())
  sessionId String
  session   WaSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  category  String // pre-key, session, sender-key, app-state-sync-key, ...
  keyId     String
  data      Json

  @@unique([sessionId, category, keyId])
  @@index([sessionId])
}

// ---------------------------------------------------------------------------
// Webhooks & API keys
// ---------------------------------------------------------------------------

// Human agents — the org's people who answer leads (vs. AI agents). Pickable
// in the Mirror Link panel. Table keeps its original name via @@map.
model HumanAgent {
  id             String        @id @default(cuid())
  // Nullable only for legacy rows created before org scoping; the app treats
  // human agents as org-owned.
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  // Optional bridge to a dashboard account: linked agents get flow handoffs
  // mirrored into inbox assignment (assignedToUserId).
  userId         String?
  user           User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  name           String
  phoneNumber    String // digits with country code, no +
  createdAt      DateTime      @default(now())

  mirrorLinks   MirrorLink[]
  mirrorThreads MirrorThread[]

  @@unique([organizationId, phoneNumber])
  @@index([organizationId])
  @@map("SalesRep")
}

// "Mirror link" (platform-admin experiment): DMs to a session are relayed
// into a per-lead WhatsApp group containing a sales rep; the rep's group
// replies are relayed back to the lead. The rep never sees the lead's number.
model MirrorLink {
  id        String    @id @default(cuid())
  sessionId String    @unique // one mirror per session (v1)
  session   WaSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  // agentNumber stays denormalized (the relay reads it); humanAgentId is the
  // directory reference for display. Number edits propagate to links.
  // Column names predate the sales-rep → human-agent rename (@map).
  agentNumber  String      @map("repNumber") // digits with country code, no +
  humanAgentId String?     @map("repId")
  humanAgent   HumanAgent? @relation(fields: [humanAgentId], references: [id], onDelete: SetNull)
  // Mirror groups are named "<groupPrefix> #<seq>".
  groupPrefix String   @default("🔒 Lead")
  // Prefix relayed messages with the lead's WhatsApp display name (bold).
  showLeadName Boolean @default(true)
  enabled     Boolean  @default(true)
  createdAt   DateTime @default(now())

  threads MirrorThread[]
}

// One lead ↔ one WhatsApp group with one human agent. Session-scoped: threads
// are created either by a static MirrorLink or by a Flow assignHuman node —
// the relay engine only reads threads, never the link.
model MirrorThread {
  id           String      @id @default(cuid())
  sessionId    String
  session      WaSession   @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  linkId       String? // set when created by a static MirrorLink
  link         MirrorLink? @relation(fields: [linkId], references: [id], onDelete: Cascade)
  humanAgentId String?
  humanAgent   HumanAgent? @relation(fields: [humanAgentId], references: [id], onDelete: SetNull)
  agentNumber  String // denormalized: the relay's sender check reads this
  // Team groups (assignGroup node): every listed number may reply as the
  // brand. Empty = single-agent thread, agentNumber alone applies.
  agentNumbers String[] @default([])
  showLeadName Boolean     @default(true)
  leadJid      String // original DM sender
  groupJid     String // the mirror group
  seq          Int // "<prefix> #<seq>" in the group subject
  createdAt    DateTime    @default(now())

  @@unique([sessionId, leadJid])
  @@unique([sessionId, groupJid])
  @@index([linkId])
}

// Monthly token meter for agents running on the platform's OpenAI account.
// One row per org per month; the period is "YYYY-MM" in UTC so the bucket a
// run belongs to never depends on server locale.
model AiTokenUsage {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  period         String
  // Tokens drawn from the PLAN's monthly allowance only; spend beyond it
  // comes out of Organization.paidAiTokens. Resets simply by moving to a new
  // period key — monthly tokens never carry over.
  tokens         Int          @default(0)
  // Set when the "10% of your allowance left" email went out, so the warning
  // fires once per month rather than on every run past the threshold.
  lowAlertSentAt DateTime?
  updatedAt      DateTime     @updatedAt

  @@unique([organizationId, period])
}

// Per-day, per-agent token spend, for the usage table. Counts every token
// consumed (included and paid alike) — the split lives in AiTokenUsage and
// Organization.paidAiTokens. `day` is midnight UTC, matching the period key.
model AiTokenDailyUsage {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  agentId        String?
  agent          Agent?       @relation(fields: [agentId], references: [id], onDelete: SetNull)
  day            DateTime
  tokens         Int          @default(0)
  updatedAt      DateTime     @updatedAt

  @@unique([organizationId, agentId, day])
  @@index([organizationId, day])
}

// A token-pack purchase. Kept for the billing history and to make top-ups
// idempotent: Stripe may deliver checkout.session.completed more than once.
model AiTokenPurchase {
  id              String       @id @default(cuid())
  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  tokens          Int
  amountCents     Int
  currency        String       @default("usd")
  stripeSessionId String       @unique
  createdAt       DateTime     @default(now())

  @@index([organizationId])
}

// ---------------------------------------------------------------------------
// Flows (platform-admin experiment): per-session visual routing graphs.
// The graph is stored exactly as the ReactFlow editor produces it.
// ---------------------------------------------------------------------------

model Flow {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  // Null = draft. At most one flow per session; assignment is an explicit
  // operation (reassigning a session detaches + disables the previous flow).
  sessionId      String?      @unique
  session        WaSession?   @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  name           String
  graph          Json // ReactFlow { nodes, edges }
  enabled        Boolean      @default(false)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  conversationStates FlowConversationState[]
  runs               FlowRun[]

  @@index([organizationId])
}

// One engine execution: which nodes ran, with what outcome. Debugging and
// audit surface for the editor's "Runs" panel.
model FlowRun {
  id             String   @id @default(cuid())
  flowId         String
  flow           Flow     @relation(fields: [flowId], references: [id], onDelete: Cascade)
  conversationId String
  leadJid        String
  // [{ nodeId, type, note? }] in execution order.
  steps          Json
  outcome        String // handed_off | agent_replied | agent_skipped | completed | error | step_limit
  error          String?
  durationMs     Int
  createdAt      DateTime @default(now())

  @@index([flowId, createdAt])
}

// Per-conversation routing memory: once HANDED_OFF, the flow no longer runs
// (the mirror thread relay owns the conversation).
model FlowConversationState {
  id             String   @id @default(cuid())
  flowId         String
  flow           Flow     @relation(fields: [flowId], references: [id], onDelete: Cascade)
  conversationId String   @unique
  status         String // ACTIVE | HANDED_OFF
  humanAgentId   String?
  updatedAt      DateTime @updatedAt

  @@index([flowId])
}

// Round-robin cursors, one per (flow, node).
model FlowCounter {
  flowId String
  nodeId String
  value  Int    @default(0)

  @@id([flowId, nodeId])
}

model Webhook {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  sessionId      String? // optional: scope to one session, else org-wide
  session        WaSession?   @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  // Optional channel filter. null = every channel. Existing rows were
  // backfilled to WHATSAPP: an org-wide webhook written against WhatsApp
  // payloads would otherwise start receiving Instagram events, whose `from` is
  // an opaque provider id rather than the phone jid every consumer assumes.
  channel        Channel?
  url            String
  secret         String // HMAC signing secret
  events         String[] // e.g. ["message.received", "session.status"]
  active         Boolean      @default(true)
  // Optional projection rules that replace `data` in deliveries: rename
  // fields, format dates, inject fixed values. Null/empty = default payload.
  // Shape: [{ target, source?, value?, dateFormat? }] — see payload-mapping.ts
  payloadMapping Json?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  deliveries WebhookDelivery[]

  @@index([organizationId])
  @@index([sessionId])
}

model ApiKey {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  hashedKey      String       @unique // sha-256 of the secret token
  prefix         String // first chars shown in UI, e.g. "wh_live_Abc…"
  lastUsedAt     DateTime?
  revokedAt      DateTime?
  createdAt      DateTime     @default(now())

  @@index([organizationId])
}

// ---------------------------------------------------------------------------
// Message log & webhook deliveries
// ---------------------------------------------------------------------------

enum MessageDirection {
  INBOUND
  OUTBOUND
}

enum MessageStatus {
  RECEIVED
  QUEUED
  SENT
  DELIVERED
  READ
  FAILED
}

enum MessageType {
  TEXT
  IMAGE
  AUDIO
  VIDEO
  DOCUMENT
  STICKER
  LOCATION
  CONTACT
  UNKNOWN
}

// Who produced a message.
enum MessageSource {
  CONTACT // inbound, from the remote party
  HUMAN // outbound, sent by a dashboard user
  API // outbound, sent via the programmatic API
  AGENT // outbound, generated by an AI agent
  MIRROR // outbound, relayed from a mirror group (senderName = human agent)
  DEVICE // outbound, typed on the phone or another linked device
  NOTE // internal team note — never sent to WhatsApp
}

// CRM-lite: a person the org talks to. Identified by phone number and/or
// WhatsApp LID (hidden identity) — at least one, enforced in the service.
model Contact {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String?
  phoneNumber    String? // digits with country code
  lid            String? // WhatsApp LID, when the phone is hidden
  notes          String?
  company        String?
  email          String?
  website        String?
  instagram      String?
  // Which of the org's numbers this person has written to.
  sessions       WaSession[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([organizationId, phoneNumber])
  @@unique([organizationId, lid])
  @@index([organizationId])
}

// Reusable canned response for the inbox composer, shared across the org.
model QuickReply {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  title          String? // optional short label shown in pickers
  text           String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId])
}

// Org-defined label for conversations (color is a hex string).
model Tag {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  color          String       @default("#25d366")
  createdAt      DateTime     @default(now())

  conversations Conversation[]

  @@unique([organizationId, name])
  @@index([organizationId])
}

// A chat thread between a session and a remote contact (or group).
enum ConversationStatus {
  OPEN
  RESOLVED
}

model Conversation {
  id              String       @id @default(cuid())
  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  sessionId       String
  session         WaSession    @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  remoteJid       String // contact/group jid
  // The contact's phone number when remoteJid is a LID (WhatsApp's hidden
  // addressing). Stored alongside rather than re-keying the thread, so a
  // conversation never forks when WhatsApp switches addressing mode. Null
  // for groups and for threads already keyed by phone jid.
  phoneNumber     String?
  name            String? // pushName / contact name
  isGroup         Boolean      @default(false)
  lastMessageAt   DateTime?
  lastMessageText String?
  lastMessageType MessageType?
  unreadCount     Int          @default(0)
  archived        Boolean      @default(false)
  avatarUrl       String? // WhatsApp profile picture (CDN URL, refreshed daily)
  avatarFetchedAt DateTime?
  agentPaused     Boolean      @default(false) // operator took over → agent won't auto-reply
  agentPausedReason String?    // why the agent handed off (null when paused manually)
  status          ConversationStatus @default(OPEN)
  tags            Tag[]
  assignedToUserId String?
  assignedTo      User?        @relation("AssignedConversations", fields: [assignedToUserId], references: [id], onDelete: SetNull)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  messages Message[]

  @@unique([sessionId, remoteJid])
  @@index([organizationId])
  @@index([sessionId, lastMessageAt])
}

model Message {
  id             String           @id @default(cuid())
  organizationId String
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  conversationId String
  conversation   Conversation     @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sessionId      String
  session        WaSession        @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  waMessageId    String?
  direction      MessageDirection
  fromMe         Boolean          @default(false)
  source         MessageSource    @default(CONTACT)
  senderName     String? // pushName of the sender (used for group context)
  type           MessageType      @default(TEXT)
  text           String? // body or media caption
  status         MessageStatus
  error          String?
  timestamp      DateTime         @default(now()) // WhatsApp message time
  raw            Json?
  createdAt      DateTime         @default(now())

  agentId String?
  agent   Agent?  @relation(fields: [agentId], references: [id], onDelete: SetNull)

  // WhatsApp reactions on this message: [{ emoji, by }]. One per reactor.
  reactions Json?

  // Which team member sent this (HUMAN outbound from the dashboard).
  sentByUserId String?
  sentBy       User?   @relation("SentMessages", fields: [sentByUserId], references: [id], onDelete: SetNull)

  media      MediaAsset?
  deliveries WebhookDelivery[]

  @@index([conversationId, timestamp])
  @@index([organizationId])
  @@index([sessionId])
  @@index([waMessageId])
}

// Stored media for a message (object lives in S3 / local disk).
model MediaAsset {
  id              String   @id @default(cuid())
  messageId       String   @unique
  message         Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  storageKey      String // object key in the media store
  mimeType        String
  fileName        String?
  size            Int?
  width           Int?
  height          Int?
  durationSeconds Int?
  sha256          String?
  createdAt       DateTime @default(now())
}

model WebhookDelivery {
  id             String      @id @default(cuid())
  webhookId      String
  webhook        Webhook  @relation(fields: [webhookId], references: [id], onDelete: Cascade)
  messageId      String?
  message        Message? @relation(fields: [messageId], references: [id], onDelete: SetNull)
  event          String
  payload        Json
  responseStatus Int?
  attempts       Int         @default(0)
  deliveredAt    DateTime?
  lastError      String?
  createdAt      DateTime    @default(now())

  @@index([webhookId])
}
