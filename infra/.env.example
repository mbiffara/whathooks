# Copy to infra/.env (gitignored) and fill in. These are resource identifiers, not
# secrets — the actual DB password lives in Secrets Manager, referenced by ARN.
# `npm run deploy` (or `npx cdk deploy`) will pick these up automatically.

# --- required ---
WH_VPC_ID=vpc-0abc123...
WH_DATABASE_URL_SECRET_ARN=arn:aws:secretsmanager:us-east-1:111122223333:secret:whathooks/database-url-XXXX
# ElastiCache Valkey (or Redis) — same wire protocol. Plain:  redis://host:6379
# With in-transit encryption (Serverless always): rediss://host:6379
# With an auth token too: rediss://:YOUR_AUTH_TOKEN@host:6379
WH_REDIS_URL=rediss://your-valkey-host:6379
WH_DB_SG_ID=sg-0rds...
WH_REDIS_SG_ID=sg-0valkey...
WH_WEB_ORIGIN=https://your-app.vercel.app

# --- optional: TLS / custom domain ---
# WH_DOMAIN_NAME=api.yourdomain.com
# Option 1 — domain in Route 53: the stack auto-creates the cert + DNS record.
# WH_HOSTED_ZONE_ID=Z0123456789ABCDEFGHIJ
# WH_HOSTED_ZONE_NAME=yourdomain.com
# Option 2 — DNS elsewhere (e.g. Vercel): import an already-issued ACM cert ARN.
# WH_CERT_ARN=arn:aws:acm:us-east-1:111122223333:certificate/XXXX
# WH_DB_PORT=5432
# WH_REDIS_PORT=6379           # cache port for the security-group rule
# WH_TASK_SUBNET_TYPE=public   # or 'private' (requires NAT egress)

# Email for CloudWatch alarm notifications (optional)
# WH_ALARM_EMAIL=you@example.com

# AI agents: each agent carries its own provider + model + API key (set in the
# dashboard, encrypted at rest). The encryption key is a Secrets Manager secret
# the stack generates automatically — nothing to configure here.
